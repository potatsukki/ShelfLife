# Android no longer stores AI provider secrets in .env.
# Configure Firebase Auth for Android with app/google-services.json.
# Configure only the deployed Cloudflare Worker URL here.
SHELFLIFE_WORKER_BASE_URL="https://replace-after-worker-deploy.workers.dev"

# Configure provider secrets in Cloudflare Worker, not Android:
